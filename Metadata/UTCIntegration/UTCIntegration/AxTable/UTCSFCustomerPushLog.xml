		<Methods>
			<Method>
				<Name>writeLog</Name>
				<Source><![CDATA[
    /// <summary>
    /// Writes an immutable audit log record for an outbound Salesforce Customer Push API call.
    /// </summary>
    /// <param name = "_custAccount">Customer account number.</param>
    /// <param name = "_partyNumber">Global Address Book party number.</param>
    /// <param name = "_requestId">X-Request-Id correlation GUID.</param>
    /// <param name = "_httpStatus">HTTP status code returned by Salesforce (e.g. 200, 400, 401, 500).</param>
    /// <param name = "_syncStatus">Resulting synchronization status.</param>
    /// <param name = "_salesforceAccountId">Salesforce Account ID returned on success.</param>
    /// <param name = "_requestPayload">Serialized JSON request body.</param>
    /// <param name = "_responsePayload">Raw HTTP response body.</param>
    /// <param name = "_durationMs">Elapsed HTTP call duration in milliseconds.</param>
    /// <param name = "_queueRecId">Optional reference to the originating queue record.</param>
    /// <returns>The inserted <c>UTCSFCustomerPushLog</c> record.</returns>
    public static UTCSFCustomerPushLog writeLog(
        CustAccount              _custAccount,
        DirPartyNumber           _partyNumber,
        UTCSFRequestId           _requestId,
        int                      _httpStatus,
        UTCSFCustomerPushStatus  _syncStatus,
        UTCSFSalesforceAccountId _salesforceAccountId,
        str                      _requestPayload,
        str                      _responsePayload,
        int                      _durationMs = 0,
        RefRecId                 _queueRecId = 0)
    {
        UTCSFCustomerPushLog logRecord;

        ttsbegin;

        logRecord.clear();
        logRecord.CustAccount         = _custAccount;
        logRecord.PartyNumber         = _partyNumber;
        logRecord.RequestId           = _requestId;
        logRecord.HttpStatus          = _httpStatus;
        logRecord.SyncStatus          = _syncStatus;
        logRecord.SalesforceAccountId = _salesforceAccountId;
        logRecord.RequestPayload      = _requestPayload;
        logRecord.ResponsePayload     = _responsePayload;
        logRecord.DurationMs          = _durationMs;
        logRecord.QueueRecId          = _queueRecId;
        logRecord.insert();

        ttscommit;

        return logRecord;
    }

]]></Source>
			</Method>
		</Methods>
	</SourceCode>

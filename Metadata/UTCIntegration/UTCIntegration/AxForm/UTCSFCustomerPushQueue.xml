		<DataControls xmlns="">
			<Control>
				<Name>ProcessSelectedQueueItemButton</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            if (!UTCSFCustomerPushQueue.RecId)
            {
                return;
            }

            changecompany('utc')
            {
                if (UTCSFCustomerPushQueue::markProcessing(UTCSFCustomerPushQueue.RecId))
                {
                    UTCSFCustomerPushQueue   selectedRecord = UTCSFCustomerPushQueue::findByRecId(UTCSFCustomerPushQueue.RecId);
                    UTCSFCustomerPushService pushService    = UTCSFCustomerPushService::construct();

                    try
                    {
                        pushService.pushCustomer(selectedRecord);
                    }
                    finally
                    {
                        pushService.dispose();
                    }
                }
                else
                {
                    warning('Only Pending queue records can be pushed manually.');
                }
            }

            UTCSFCustomerPushQueue_ds.research(true);
        }

]]></Source>
					</Method>
				</Methods>
			</Control>

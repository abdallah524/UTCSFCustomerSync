		<DataControls xmlns="">
			<Control>
				<Name>RepushCustomerButton</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            if (!UTCSFCustomerPushLog.CustAccount)
            {
                return;
            }

            changecompany('utc')
            {
                CustTable custTable = CustTable::find(UTCSFCustomerPushLog.CustAccount);
                if (!custTable.RecId)
                {
                    warning(strFmt('Customer %1 not found in company utc.', UTCSFCustomerPushLog.CustAccount));
                    return;
                }

                UTCSFCustomerPushQueue queueRecord = UTCSFCustomerPushQueue::enqueue(custTable.AccountNum, 'D365FO');
                if (UTCSFCustomerPushQueue::markProcessing(queueRecord.RecId))
                {
                    UTCSFCustomerPushQueue   activeQueue = UTCSFCustomerPushQueue::findByRecId(queueRecord.RecId);
                    UTCSFCustomerPushService pushService = UTCSFCustomerPushService::construct();
                    boolean                  pushed;

                    try
                    {
                        pushed = pushService.pushCustomer(activeQueue);
                    }
                    finally
                    {
                        pushService.dispose();
                    }

                    if (pushed)
                    {
                        info(strFmt('Customer %1 successfully pushed to Salesforce.', custTable.AccountNum));
                    }
                    else
                    {
                        error(strFmt('Customer %1 push failed. Check the latest log entry for details.', custTable.AccountNum));
                    }
                }
            }

            UTCSFCustomerPushLog_ds.executeQuery();
        }

]]></Source>
					</Method>

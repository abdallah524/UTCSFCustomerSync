				<Name>TestConnectionButton</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            UTCSFIntegrationParameters_ds.write();

            UTCSFCustomerPushService service = UTCSFCustomerPushService::construct();
            boolean                  isHealthy;
            int                      httpStatus;
            str                      responseBody;

            try
            {
                [isHealthy, httpStatus, responseBody] = service.checkHealth();
            }
            finally
            {
                service.dispose();
            }

            UTCSFIntegrationParameters_ds.reread();
            UTCSFIntegrationParameters_ds.refresh();

            if (isHealthy)
            {
                info(strFmt('Salesforce Health Check succeeded (HTTP %1): %2', httpStatus, responseBody));
            }
            else
            {
                error(strFmt('Salesforce Health Check failed (HTTP %1): %2', httpStatus, responseBody));
            }
        }

]]></Source>
					</Method>
				</Methods>
			</Control>
			<Control>
				<Name>ClearTokenCacheButton</Name>
				<Type>Button</Type>
				<Methods>
					<Method>
						<Name>clicked</Name>
						<Source><![CDATA[
        public void clicked()
        {
            super();

            changecompany('utc')
            {
                UTCSFIntegrationParameters::clearCachedToken();
            }
            UTCSFIntegrationParameters_ds.reread();
            UTCSFIntegrationParameters_ds.refresh();

            info('Cached Salesforce OAuth2 access token has been cleared.');
        }

]]></Source>
					</Method>
